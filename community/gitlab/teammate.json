{
  "name": "gitlab",
  "display_name": "GitLab",
  "version": "2.0.0",
  "description": "Monitors GitLab merge requests, CI pipelines, and mentions",
  "author": "hivescanner-community",
  "adapter_file": "adapter.py",
  "config_template": {
    "enabled": false,
    "token_env": "GITLAB_TOKEN",
    "gitlab_url": "https://gitlab.com",
    "username": "",
    "watch_projects": [],
    "watch_reviews": true,
    "watch_pipelines": true,
    "watch_todos": true,
    "max_items": 100,
    "max_pages": 3,
    "projects_per_poll": 3,
    "overlap_minutes": 10
  },
  "requirements": {
    "cli_tools": []
  },
  "qpm_budget": 3
}
