{
  "name": "sentry",
  "display_name": "Sentry",
  "version": "2.0.0",
  "description": "Monitors Sentry issues and error spikes",
  "author": "hivescanner-community",
  "adapter_file": "adapter.py",
  "config_template": {
    "enabled": false,
    "token_env": "SENTRY_TOKEN",
    "organization": "",
    "project": "",
    "query": "is:unresolved",
    "min_event_delta": 10,
    "spike_ratio": 2.0,
    "max_items": 100,
    "max_pages": 10
  },
  "requirements": {
    "cli_tools": []
  },
  "qpm_budget": 2
}
