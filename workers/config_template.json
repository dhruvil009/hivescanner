{
  "version": 2,
  "poll_interval_seconds": 300,
  "queue_retention_days": 7,
  "user": {
    "username": "YOUR_USERNAME",
    "email": ""
  },
  "autonomy": {
    "enabled": false,
    "oncall_groups": [],
    "transports": {},
    "group_policies": {}
  },
  "scanners": {
    "github": {
      "enabled": true,
      "token_env": "GITHUB_TOKEN",
      "username": "",
      "watch_repos": [],
      "watch_reviews": true,
      "watch_ci": true,
      "watch_mentions": true,
      "watch_assignments": true,
      "watch_activity": false,
      "max_items_per_query": 20,
      "max_notification_pages": 10,
      "max_pr_pages": 10
    },
    "calendar": {
      "enabled": false,
      "reminder_minutes": [30, 10],
      "max_events": 1000,
      "max_pages": 10,
      "lookahead_days": 30,
      "calendars": [],
      "timezone": "",
      "filter_declined": true,
      "noise_subjects": ["Focus Time", "Lunch", "OOO"]
    },
    "git_status": {
      "enabled": true,
      "watch_dirs": ["."],
      "warn_uncommitted_after_minutes": 60,
      "warn_branch_behind": true,
      "repos_per_poll": 5
    },
    "gchat": {
      "enabled": false,
      "watch_spaces": [],
      "watch_dm_spaces": [],
      "watch_dms": true,
      "user_resource": "",
      "username": "",
      "max_messages": 20,
      "max_pages": 10,
      "spaces_per_poll": 5
    },
    "whatsapp": {
      "enabled": false,
      "watch_chats": [],
      "max_messages": 20,
      "max_pages_per_poll": 100,
      "store_path": ""
    },
    "email": {
      "enabled": false,
      "vip_senders": [],
      "query": "in:inbox",
      "max_emails": 20,
      "max_pages": 5,
      "overlap_seconds": 300
    },
    "weather": {
      "enabled": false,
      "location": "",
      "morning_hour": 8,
      "timezone": "",
      "morning_window_hours": 4,
      "alert_temp_swing_c": 10
    }
  }
}
